<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Total Income Result</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="page">
    <div class="card result-card">
      <header class="card-header">
        <h1>Total Income</h1>
        <p class="muted">Calculated securely on the server</p>
      </header>

      <div class="breakdown">
        <div class="row"><span>Income (Source 1)</span><strong>₹ <%= source1 %></strong></div>
        <div class="row"><span>Income (Source 2)</span><strong>₹ <%= source2 %></strong></div>
        <hr>
        <div class="row total"><span>Total</span><strong>₹ <%= total %></strong></div>
      </div>

      <div class="actions center">
        <a href="/" class="btn">New calculation</a>
      </div>

      <footer class="card-foot">
        <small>Values shown with two decimals.</small>
      </footer>
    </div>
  </main>
</body>
</html>
